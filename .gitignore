# Terraform
# .terraform.lock.hcl is intentionally NOT ignored — commit it to pin provider
# versions + checksums for reproducible `terraform init` across the team.
**/.terraform/
**/*.tfstate
**/*.tfstate.*
*.tfplan

# Lambda zips (generated)
**/*.zip

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Disabled files
*.disabled

# LXD orchestrator local failure logs
infra/lxd/failures.log*
